<Window
    x:Class="Clipboard.Windows.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="剪贴板设置">
    <TabView IsAddTabButtonVisible="False">
        <TabViewItem Header="常规设置" IsClosable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="Root"
            Padding="24"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="设置" />
            <StackPanel Grid.Row="1" Margin="0,22,0,0" Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="历史记录" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="收藏项永不自动清理。"
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="MaxItemsEnabledCheckBox"
                        VerticalAlignment="Center"
                        Content="限制最大条数" />
                    <NumberBox
                        x:Name="MaxItemsNumberBox"
                        Grid.Column="1"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="MaxAgeEnabledCheckBox"
                        VerticalAlignment="Center"
                        Content="限制保留天数" />
                    <NumberBox
                        x:Name="MaxAgeNumberBox"
                        Grid.Column="1"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="MaxImageEnabledCheckBox"
                        VerticalAlignment="Center"
                        Content="限制图片空间（GiB）" />
                    <NumberBox
                        x:Name="MaxImageNumberBox"
                        Grid.Column="1"
                        Minimum="0.1"
                        SmallChange="0.1"
                        SpinButtonPlacementMode="Compact" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        x:Name="MaxFavoriteFileCacheEnabledCheckBox"
                        VerticalAlignment="Center"
                        Content="保留收藏文件缓存（GiB）" />
                    <NumberBox
                        x:Name="MaxFavoriteFileCacheNumberBox"
                        Grid.Column="1"
                        Minimum="0.1"
                        SmallChange="0.1"
                        SpinButtonPlacementMode="Compact" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,24,0,0" Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="快捷键" />
                <ToggleSwitch
                    x:Name="InterceptWinVToggle"
                    Header="尝试接管 Win+V" />
                <TextBox
                    x:Name="FallbackHotkeyTextBox"
                    Header="备用快捷键"
                    PlaceholderText="Alt+V" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,24,0,0" Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="应用" />
                <ToggleSwitch
                    x:Name="StartWithWindowsToggle"
                    Header="开机启动" />
                <ComboBox
                    x:Name="ThemeComboBox"
                    Header="主题"
                    SelectedIndex="0">
                    <ComboBoxItem Content="跟随系统" Tag="system" />
                    <ComboBoxItem Content="浅色" Tag="light" />
                    <ComboBoxItem Content="深色" Tag="dark" />
                </ComboBox>
            </StackPanel>
            <Grid Grid.Row="4" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="ErrorText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Content="取消" />
                <Button
                    Grid.Column="2"
                    Click="SaveButton_Click"
                    Content="保存" />
            </Grid>
        </Grid>
    </ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="同步设置" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="24" Spacing="12">
                    <ToggleSwitch x:Name="SyncEnabledToggle" Header="启用同步" />
                    <ComboBox x:Name="SyncProviderComboBox" Header="服务类型" SelectedIndex="0" SelectionChanged="SyncProviderComboBox_SelectionChanged">
                        <ComboBoxItem Content="WebDAV" Tag="webdav" />
                        <ComboBoxItem Content="阿里云 OSS" Tag="oss" />
                    </ComboBox>
                    <TextBox x:Name="SyncEndpointTextBox" Header="服务端点" PlaceholderText="https://..." />
                    <StackPanel x:Name="WebDavFields" Spacing="12">
                        <TextBox x:Name="SyncRootPathTextBox" Header="WebDAV 根路径" PlaceholderText="/" />
                    </StackPanel>
                    <StackPanel x:Name="OssFields" Spacing="12">
                        <TextBox x:Name="SyncBucketTextBox" Header="OSS Bucket" />
                        <TextBox x:Name="SyncRegionTextBox" Header="OSS 区域" PlaceholderText="cn-hangzhou" />
                        <TextBox x:Name="SyncPrefixTextBox" Header="OSS 前缀" />
                    </StackPanel>
                    <TextBox x:Name="SyncAccountTextBox" Header="WebDAV 用户名或 AccessKey ID" />
                    <PasswordBox x:Name="SyncSecretPasswordBox" Header="WebDAV 密码或 AccessKey Secret" />
                    <TextBlock x:Name="SyncStatusText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Click="ProbeSyncButton_Click" Content="测试连接" />
                        <Button Click="RunSyncButton_Click" Content="立即同步" />
                        <Button Click="SaveSyncButton_Click" Content="保存" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
    </TabView>
</Window>
